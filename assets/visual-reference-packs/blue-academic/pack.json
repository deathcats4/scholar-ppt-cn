{
  "$schema": "../../../schemas/visual-reference-pack.schema.json",
  "schema_version": "1.0.0",
  "pack_id": "blue-academic",
  "pack_version": "0.1.0",
  "status": "active",
  "language": "zh-CN",
  "canvas": {
    "aspect_ratio": "16:9",
    "width_px": 1600,
    "height_px": 900,
    "format": "png"
  },
  "visual_identity": {
    "background": "pure-white",
    "base_direction": "稳定、清晰、现代的蓝色中文学术演示基线",
    "accent_policy": "不预设固定强调色，由设计模型根据页面任务克制发挥",
    "layout_freedom": "high",
    "notes": [
      "视觉身份保持一致，但不固定页面几何",
      "卡片、边框与阴影仅在有助于信息组织时使用",
      "参考图不得直接作为最终幻灯片背景"
    ]
  },
  "font_policy": {
    "reference_cjk_style": "现代清晰、接近微软雅黑气质的中文无衬线字体",
    "editable_cjk_default": "Microsoft YaHei",
    "editable_latin_default": "Times New Roman",
    "inherit_reference_font": false
  },
  "runtime_policy": {
    "json_filter_first": true,
    "max_images_to_open": 3,
    "planning_before_reference_retrieval": true,
    "reference_authority": "aesthetic-anchor-only",
    "compose_from_project_content": true,
    "allow_full_slide_raster_use": false,
    "allow_pixel_matching": false,
    "contact_sheet_runtime_default": false
  },
