{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-ppt-cn:visual-reference-pack:1.0.0",
  "title": "Scholar PPT CN Visual Reference Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "status",
    "language",
    "canvas",
    "visual_identity",
    "font_policy",
    "runtime_policy",
    "references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "language": {
      "const": "zh-CN"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "visual_identity": {
      "$ref": "#/$defs/visualIdentity"
    },
    "font_policy": {
      "$ref": "#/$defs/fontPolicy"
    },
    "runtime_policy": {
      "$ref": "#/$defs/runtimePolicy"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "width_px",
        "height_px",
        "format"
      ],
      "properties": {
        "aspect_ratio": {
          "const": "16:9"
        },
        "width_px": {
          "const": 1600
        },
        "height_px": {
          "const": 900
        },
        "format": {
          "const": "png"
        }
      }
    },
    "visualIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "base_direction",
        "accent_policy",
        "layout_freedom",
        "notes"
      ],
      "properties": {
        "background": {
          "const": "pure-white"
        },
        "base_direction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accent_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "layout_freedom": {
          "const": "high"
        },
        "notes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "fontPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_cjk_style",
        "editable_cjk_default",
        "editable_latin_default",
        "inherit_reference_font"
      ],
      "properties": {
        "reference_cjk_style": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editable_cjk_default": {
          "const": "Microsoft YaHei"
        },
        "editable_latin_default": {
          "const": "Times New Roman"
        },
        "inherit_reference_font": {
          "const": false
        }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_filter_first",
        "max_images_to_open",
        "planning_before_reference_retrieval",
        "reference_authority",
        "compose_from_project_content",
        "allow_full_slide_raster_use",
        "allow_pixel_matching",
        "contact_sheet_runtime_default"
      ],
      "properties": {
        "json_filter_first": {
          "const": true
        },
        "max_images_to_open": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "planning_before_reference_retrieval": {
          "const": true
        },
        "reference_authority": {
          "const": "aesthetic-anchor-only"
        },
        "compose_from_project_content": {
          "const": true
        },
        "allow_full_slide_raster_use": {
          "const": false
        },
        "allow_pixel_matching": {
          "const": false
        },
        "contact_sheet_runtime_default": {
          "const": false
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "metadata_file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{2}$"
        },
        "file": {
          "type": "string",
          "pattern": "^images/[a-z0-9][a-z0-9-]*-[0-9]{2}\\.png$"
        },
        "metadata_file": {
          "type": "string",
          "pattern": "^metadata/[a-z0-9][a-z0-9-]*-[0-9]{2}\\.json$"
        }
      }
    }
  }
}
