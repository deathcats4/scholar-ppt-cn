{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-ppt-cn:visual-reference-generation-plan:1.0.0",
  "title": "Scholar PPT CN Visual Reference Generation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "pack_id",
    "status",
    "objective",
    "output_spec",
    "shared_prompt",
    "visible_copy",
    "evaluation",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed"
      ]
    },
    "objective": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "output_spec": {
      "$ref": "#/$defs/outputSpec"
    },
    "shared_prompt": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "visible_copy": {
      "$ref": "#/$defs/visibleCopy"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "target_width_px",
        "target_height_px",
        "format",
        "language"
      ],
      "properties": {
        "aspect_ratio": {
          "const": "16:9"
        },
        "target_width_px": {
          "const": 1600
        },
        "target_height_px": {
          "const": 900
        },
        "format": {
          "const": "png"
        },
        "language": {
          "const": "zh-CN"
        }
      }
    },
    "visibleCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "interpretation",
        "caption"
      ],
      "properties": {
        "eyebrow": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "interpretation": {
          "$ref": "#/$defs/stringArray"
        },
        "caption": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions",
        "admission"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "visual_quality",
              "editable_transferability"
            ]
          },
          "uniqueItems": true
        },
        "admission": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pair_id",
        "variant",
        "source_task_id",
        "composition",
        "task_prompt",
        "status",
        "output_file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dominant-result-[0-9]{2}-[ab]$"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^dominant-result-[0-9]{2}$"
        },
        "variant": {
          "enum": [
            "A-realistic-synthetic",
            "B-neutral-simulated"
          ]
        },
        "source_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "composition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "task_prompt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "planned",
            "generated",
            "reviewed",
            "selected",
            "rejected"
          ]
        },
        "output_file": {
          "type": "string",
          "pattern": "^candidates/dominant-result-[0-9]{2}-[ab]\\.png$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "summary",
        "selected_reference_ids",
        "notes"
      ],
      "properties": {
        "decision": {
          "const": "realistic-generic"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "selected_reference_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
