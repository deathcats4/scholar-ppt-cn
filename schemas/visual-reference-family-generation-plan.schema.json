{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-ppt-cn:visual-reference-family-generation-plan:1.0.0",
  "title": "Scholar PPT CN Visual Reference Family Generation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "pack_id",
    "status",
    "objective",
    "anchor_image",
    "output_spec",
    "shared_prompt",
    "generation_policy",
    "admission",
    "roles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed"
      ]
    },
    "objective": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "anchor_image": {
      "type": "string",
      "pattern": "^\\.\\./contact-sheet\\.png$"
    },
    "output_spec": {
      "$ref": "#/$defs/outputSpec"
    },
    "shared_prompt": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "generation_policy": {
      "$ref": "#/$defs/generationPolicy"
    },
    "admission": {
      "$ref": "#/$defs/stringArray"
    },
    "roles": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "target_width_px",
        "target_height_px",
        "format",
        "language"
      ],
      "properties": {
        "aspect_ratio": {
          "const": "16:9"
        },
        "target_width_px": {
          "const": 1600
        },
        "target_height_px": {
          "const": 900
        },
        "format": {
          "const": "png"
        },
        "language": {
          "const": "zh-CN"
        }
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_candidates_per_role",
        "one_image_per_request",
        "use_anchor_image",
        "independent_variants",
        "human_review_required"
      ],
      "properties": {
        "minimum_candidates_per_role": {
          "const": 3
        },
        "one_image_per_request": {
          "const": true
        },
        "use_anchor_image": {
          "const": true
        },
        "independent_variants": {
          "const": true
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "objective",
        "variants"
      ],
      "properties": {
        "role": {
          "enum": [
            "cover",
            "research-gap",
            "research-question",
            "method-design",
            "comparison",
            "multi-panel",
            "mechanism",
            "discussion-outlook",
            "conclusion"
          ]
        },
        "objective": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "variants": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_geometry",
        "example_topic",
        "visible_copy",
        "task_prompt",
        "status",
        "output_file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z-]+-[0-9]{2}$"
        },
        "asset_geometry": {
          "enum": [
            "none",
            "text-led",
            "wide",
            "tall",
            "balanced-pair",
            "multi-panel",
            "flow",
            "network",
            "mixed"
          ]
        },
        "example_topic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "visible_copy": {
          "$ref": "#/$defs/stringArray"
        },
        "task_prompt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "planned",
            "generated",
            "reviewed",
            "selected",
            "rejected"
          ]
        },
        "output_file": {
          "type": "string",
          "pattern": "^candidates/[a-z][a-z-]+-[0-9]{2}\\.png$"
        }
      }
    }
  }
}
