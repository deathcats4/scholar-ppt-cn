{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-ppt-cn:visual-reference-item:1.0.0",
  "title": "Scholar PPT CN Visual Reference Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "file",
    "role",
    "asset_geometry",
    "density",
    "title_mode",
    "example_content",
    "editable_rebuild",
    "learn",
    "do_not_copy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{2}$"
    },
    "file": {
      "type": "string",
      "pattern": "^../images/[a-z0-9][a-z0-9-]*-[0-9]{2}\\.png$"
    },
    "role": {
      "enum": [
        "cover",
        "research-gap",
        "research-question",
        "method-design",
        "dominant-result",
        "comparison",
        "multi-panel",
        "mechanism",
        "discussion-outlook",
        "conclusion"
      ]
    },
    "asset_geometry": {
      "enum": [
        "none",
        "low-asset",
        "wide",
        "tall",
        "square",
        "comparison",
        "dense-multi-panel",
        "process",
        "diagram",
        "table",
        "mixed"
      ]
    },
    "density": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "title_mode": {
      "enum": [
        "topic",
        "takeaway",
        "mixed"
      ]
    },
    "example_content": {
      "type": "boolean"
    },
    "editable_rebuild": {
      "const": true
    },
    "learn": {
      "$ref": "#/$defs/stringArray"
    },
    "do_not_copy": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    }
  }
}
